{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/disruptionjoe/gu-formalization/lab/specifications/theory-passport/theory-passport-v0.1.schema.json",
  "title": "GU theory passport v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "passport_id", "program", "truth_status", "critical_path",
    "freeze_wall", "null_hypothesis", "comparators", "export_contract", "promotion"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "passport_id": {"type": "string", "minLength": 1},
    "program": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "agenda_item", "repository", "question"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "agenda_item": {"type": "string", "minLength": 1},
        "repository": {"const": "gu-formalization"},
        "question": {"type": "string", "minLength": 1}
      }
    },
    "truth_status": {
      "type": "object", "additionalProperties": false,
      "required": ["grade", "claim_effect", "current_root_candidate_set"],
      "properties": {
        "grade": {"const": "research_architecture_only"},
        "claim_effect": {"const": "none"},
        "current_root_candidate_set": {"type": "array", "maxItems": 0}
      }
    },
    "critical_path": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "prefixItems": [
        {"$ref": "#/$defs/actionBurden"},
        {"$ref": "#/$defs/stateBurden"},
        {"$ref": "#/$defs/observableBurden"}
      ],
      "items": false
    },
    "freeze_wall": {
      "type": "object", "additionalProperties": false,
      "required": ["timing", "frozen_before_scoring"],
      "properties": {
        "timing": {"const": "before_observable_scoring"},
        "frozen_before_scoring": {
          "type": "array", "minItems": 7, "uniqueItems": true,
          "items": {"enum": [
            "action_coefficients", "vacuum_background", "stabilizer_spectrum",
            "causal_domain_boundary", "physical_quotient_state_pairing",
            "projection_parameters", "held_out_consequence"
          ]}
        }
      }
    },
    "null_hypothesis": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "statement", "defeat_condition"],
      "properties": {
        "id": {"const": "H0"}, "status": {"const": "live"},
        "statement": {"type": "string", "minLength": 1},
        "defeat_condition": {"type": "string", "minLength": 1}
      }
    },
    "comparators": {
      "type": "array", "minItems": 6, "uniqueItems": true,
      "items": {"enum": [
        "general_relativity", "standard_model", "ordinary_qft_eft_quantization",
        "thermodynamics_cosmology", "non_gu_unification", "null_or_rival_model"
      ]}
    },
    "export_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["target", "status", "required_payload"],
      "properties": {
        "target": {"const": "dynamic-unity"},
        "status": {"const": "not_ready"},
        "required_payload": {
          "type": "array", "minItems": 5, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "promotion": {
      "type": "object", "additionalProperties": false,
      "required": ["scientific_promotions", "note"],
      "properties": {
        "scientific_promotions": {"type": "array", "maxItems": 0},
        "note": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "burdenBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "id", "status", "depends_on", "gate", "required_objects", "evidence_refs"],
      "properties": {
        "order": {"type": "integer", "minimum": 1, "maximum": 3},
        "id": {"type": "string"},
        "status": {"enum": ["blocked", "open", "satisfied"]},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "gate": {"type": "string", "minLength": 1},
        "required_objects": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "actionBurden": {
      "allOf": [
        {"$ref": "#/$defs/burdenBase"},
        {"type": "object",
         "properties": {"order": {"const": 1}, "id": {"const": "action_causal_closure"}, "depends_on": {"maxItems": 0}}}
      ]
    },
    "stateBurden": {
      "allOf": [
        {"$ref": "#/$defs/burdenBase"},
        {"type": "object",
         "properties": {"order": {"const": 2}, "id": {"const": "physical_state_space"},
         "depends_on": {"const": ["action_causal_closure"]}}}
      ]
    },
    "observableBurden": {
      "allOf": [
        {"$ref": "#/$defs/burdenBase"},
        {"type": "object",
         "properties": {"order": {"const": 3}, "id": {"const": "observable_export"},
         "depends_on": {"const": ["physical_state_space"]}}}
      ]
    }
  }
}
