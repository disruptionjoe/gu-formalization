{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capacityos.local/gu/conditional-evidence-delta.schema.json",
  "title": "GU conditional evidence delta",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "delta_id",
    "status",
    "base",
    "affected_rows",
    "result_refs",
    "source_disposition",
    "claim_ceiling",
    "proposed_effect",
    "conflict_keys",
    "integration"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "delta_id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]+$" },
    "status": {
      "enum": [
        "pending",
        "integrated",
        "duplicate",
        "deferred",
        "conflicting",
        "withdrawn"
      ]
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ledger_ref", "ledger_sha256"],
      "properties": {
        "ledger_ref": { "type": "string", "minLength": 1 },
        "ledger_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "affected_rows": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "result_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "source_disposition": { "type": "string", "minLength": 1 },
    "claim_ceiling": { "type": "string", "minLength": 1 },
    "proposed_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "requested_row_changes"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "requested_row_changes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "conflict_keys": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "integration": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["disposition", "canonical_ledger_ref", "reason"],
          "properties": {
            "disposition": {
              "enum": ["incorporated", "duplicate", "deferred", "conflicting"]
            },
            "canonical_ledger_ref": { "type": ["string", "null"] },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
